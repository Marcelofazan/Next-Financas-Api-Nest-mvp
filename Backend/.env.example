PORT=3001
NODE_ENV=development

# Opção 1: connection string completa (ex: Neon, Railway, Supabase)
DATABASE_URL=[SUA_URL_CONEXAO]

# Opção 2: variáveis individuais para PostgreSQL local (usado quando DATABASE_URL não está definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=[SUA_SENHA]
DB_NAME=financas-db

# JWT
JWT_SECRET=troque_esta_chave_em_producao
